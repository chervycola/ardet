 export const useTexts = {
-  'terminal': { title: `СЦЕНА`, text: `Ты подходишь к краю сцены. Камень холодный. Зал — пустой. Четыре силуэта продолжают свою сцену, не глядя на тебя. Они тебя не видят. Возможно, они не видят никого. Возможно, они ждут, пока кто-то увидит их всех — по очереди, по-настоящему. Только тогда зал заполнится. Только тогда сцена примет нового актёра.` },
