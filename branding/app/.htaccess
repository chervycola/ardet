# ДИСКРЕТ · правила для красивых персональных ссылок
# Любой несуществующий путь отдаём приложению (index.html),
# оно само откроет карточку: дискрет.рф/TiihayaRekaa, /EXTREMUM, /Paratek…
# Реальные файлы (bot.php, photos/*) продолжают работать как раньше.
RewriteEngine On
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.html [L]
